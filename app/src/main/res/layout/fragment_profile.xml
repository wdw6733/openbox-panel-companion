<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="配置开关只发最小的部分更新，是否生效以回读结果为准。完整配置请在面板网页里改。"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_profile_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="刷新" />

        <ProgressBar
            android:id="@+id/progress_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_profile_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/colorError"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="开关"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_ipv6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="IPv6" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_reject_quic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="屏蔽 QUIC" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_direct_bypass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="直连不进内核" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_tun_auto_redirect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TUN 自动重定向" />

        <TextView
            android:id="@+id/text_profile_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="配置摘要"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_profile_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="尚未加载"
            android:textSize="13sp"
            android:typeface="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_profile_open_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="在面板中打开配置" />
    </LinearLayout>
</ScrollView>
