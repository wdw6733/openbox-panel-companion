<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The panel is plain HTTP on the LAN by design, so cleartext is
         permitted. Only use this app on networks you trust, or behind
         your own VPN / SSH tunnel / TLS reverse proxy. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
